# Google Gemini API Key (required for LLM extraction)
GOOGLE_API_KEY=your_gemini_api_key_here

# Neo4j Connection (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=operation_rakt

# Tesseract OCR path (Windows default after installation)
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
