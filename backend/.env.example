# Google Gemini API Key (required for LLM extraction)
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Gemini Model Name
GEMINI_MODEL_NAME=gemini-3.8-flash

# Neo4j Connection (matches docker-compose.yml defaults)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=operation_rakt

# Tesseract OCR path (Mac Homebrew default)
TESSERACT_CMD=/opt/homebrew/bin/tesseract
